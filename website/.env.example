# Copy this file to `.env` in the same directory (website/) and fill in
# real values. `.env` is gitignored and must never be committed.
#
# Two ready-made setups are below - keep the block you need, delete the other.

# ------------------------------------------------------------------------
# Required in every environment
# ------------------------------------------------------------------------

# Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Use a DIFFERENT key on the server than on your machine.
DJANGO_SECRET_KEY=

# ------------------------------------------------------------------------
# LOCAL DEVELOPMENT (python manage.py runserver, plain http)
# ------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_SECURE_SSL_REDIRECT=False

# ------------------------------------------------------------------------
# PRODUCTION (Ubuntu server behind nginx + HTTPS) - use these instead:
# ------------------------------------------------------------------------
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=zacoinfotech.com,www.zacoinfotech.com
# Keep False until HTTPS (certbot) is working, then set to True.
# DJANGO_SECURE_SSL_REDIRECT=False

# ------------------------------------------------------------------------
# Enquiry emails
# ------------------------------------------------------------------------

# Everyone in this list gets every contact-form / newsletter enquiry
# (comma-separated). Defaults to these two addresses if omitted.
LEAD_NOTIFICATION_EMAILS=info@zacoinfotech.com,abhiraj@zacocomputer.com

# SMTP account the site sends from. For Gmail use an App Password (not your
# login password). Leave blank locally: forms still save the lead, but no
# email is sent and the SMTP error is only logged.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
