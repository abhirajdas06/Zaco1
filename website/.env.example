# Copy this file to `.env` in the same directory (website/) and fill in
# real values. `.env` is gitignored and must never be committed.

# Generate a fresh one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# False in production, True only for local development
DJANGO_DEBUG=False

# Comma-separated, no spaces around commas needed
DJANGO_ALLOWED_HOSTS=zacoinfotech.com,www.zacoinfotech.com

# Set to False until HTTPS (certbot) is working, then switch to True
DJANGO_SECURE_SSL_REDIRECT=False

# Gmail SMTP (or your provider) — use an app password, not your login password
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
